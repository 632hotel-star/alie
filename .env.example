# Public site configuration. Copy to .env.local and edit.
# Leave APP_STORE_URL empty until the app is really published: the site then shows an honest "coming soon" CTA.
NEXT_PUBLIC_APP_STORE_URL=
# Working brand name (temporary). Changing it here renames the site everywhere.
NEXT_PUBLIC_BRAND_NAME=BetterMe
# Contact mailbox shown on /contact. Leave empty if not decided yet.
NEXT_PUBLIC_CONTACT_EMAIL=
# Canonical URL used for metadata / OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
